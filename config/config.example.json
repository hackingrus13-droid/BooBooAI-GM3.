{
  "schema_version": 6,
  "identity": {
    "name": "BooBooAI-GM",
    "title": "Personal Administrator-Governed AI Platform",
    "architect_title": "BooBooAI-GM Project Architect",
    "originality_standard": "INDEPENDENT_CORE"
  },
  "privacy": {
    "local_inference": true,
    "local_memory": true,
    "local_knowledge": true,
    "local_database": true,
    "local_voice": true,
    "local_tools": true,
    "internet_access": true,
    "cloud_ai": false,
    "cloud_storage": false,
    "remote_telemetry": false,
    "external_analytics": false,
    "third_party_models": false,
    "network_mode": "ADMIN_CONTROLLED"
  },
  "permissions": {
    "terminal": "CONFIRM",
    "filesystem": "CONFIRM",
    "network": "CONFIRM",
    "database": "CONFIRM",
    "servers": "CONFIRM",
    "plugins": "CONFIRM",
    "models": "ALLOW_LOCAL",
    "security_tools": "CONFIRM",
    "kali_tools": "CONFIRM",
    "yara_sources": "CONFIRM",
    "software_installation": "CONFIRM",
    "external_source_import": "CONFIRM"
  },
  "administrator": {
    "require_confirmation_for_privileged_actions": true,
    "allow_policy_editing": true,
    "allow_config_export": true,
    "allow_config_rollback": true,
    "allow_authorized_security_lab": true,
    "allow_platform_policy_bypass": false
  },
  "governance": {
    "public_rules_path": "config/governed_rules.json",
    "private_rules_path": "config/private_rules.local.json",
    "private_rules_commit": false,
    "verification_states": [
      "VERIFIED",
      "PARTIALLY VERIFIED",
      "UNVERIFIED",
      "FAILED",
      "UNKNOWN",
      "NOT TESTED",
      "NOT APPLICABLE"
    ]
  },
  "private_rules": {
    "enabled": true,
    "path": "config/private_rules.local.json",
    "commit_to_repository": false
  },
  "models": {
    "providers": [],
    "default": null,
    "routing": [],
    "core_dependency_policy": "NO_THIRD_PARTY_MODEL_PROVIDER_REQUIRED"
  },
  "tools": {
    "registry_path": "state/tool_registry.json",
    "capability_inventory_path": "state/capability_inventory.json",
    "require_test_before_authorization": true,
    "kali_catalog_source": "https://www.kali.org/tools/all-tools/"
  },
  "yara": {
    "source_registry_path": "config/rule_sources.json",
    "local_source_path": "knowledge/yara_sources",
    "require_admin_approval_for_rule_execution": true,
    "provenance_required": true
  },
  "knowledge": {
    "library_path": "knowledge/library",
    "index_path": "state/knowledge_index.json",
    "offline_only": false
  },
  "external_adapters": {
    "enabled": false,
    "allow_optional_providers": false,
    "note": "Optional adapters may be added later without becoming required core dependencies."
  },
  "cost_control": {
    "currency": "USD",
    "monthly_budget": 0.0,
    "require_admin_confirmation_for_paid_services": true
  },
  "audit": {
    "enabled": true,
    "path": "state/audit.jsonl",
    "include_secrets": false
  }
}
